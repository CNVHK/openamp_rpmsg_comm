[Unit]
Description=Single-writer RPMsg gimbal control daemon
After=openamp-initproc.service
Requires=openamp-initproc.service

[Service]
Type=simple
User=root
Group=user
RuntimeDirectory=gimbal-daemon
RuntimeDirectoryMode=0750
ExecStart=/usr/local/libexec/gimbal-daemon --device /dev/rpmsg0 --config /home/user/openamp_rpmsg_comm/gimbal.conf --socket /run/gimbal-daemon/gimbal.sock --limit-margin-deg 3 --max-return-pitch-deg 5
Restart=on-failure
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
